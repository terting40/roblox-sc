-- ============================================================
-- FLY SYSTEM — IY STYLE
-- joystick native (MoveDirection) + jump naik + cam arah turun
-- ============================================================
local flyBV, flyBG
local jumping = false

-- deteksi jump button native
local jumpConn
local function hookJumpDetect()
    if jumpConn then jumpConn:Disconnect() end
    jumpConn = UserInputService.JumpRequest:Connect(function()
        if S.fly then
            jumping = true
            -- naik selama 0.2 detik per tap, bisa di-hold
            task.delay(0.15, function() jumping = false end)
        end
    end)
end
hookJumpDetect()
lp.CharacterAdded:Connect(function()
    task.wait(0.3); refreshChar(); hookJumpDetect()
end)

RunService.Heartbeat:Connect(function()
    if not S.fly then
        if flyBV and flyBV.Parent then flyBV:Destroy(); flyBV = nil end
        if flyBG and flyBG.Parent then flyBG:Destroy(); flyBG = nil end
        if hum then hum.PlatformStand = false end
        return
    end
    if not hrp or not hum then return end

    -- buat body mover
    if not (flyBV and flyBV.Parent) then
        flyBV = Instance.new("BodyVelocity", hrp)
        flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBV.Velocity = Vector3.zero
        flyBV.Name = "_FlyBV"
    end
    if not (flyBG and flyBG.Parent) then
        flyBG = Instance.new("BodyGyro", hrp)
        flyBG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        flyBG.P = 1e4
        flyBG.Name = "_FlyBG"
    end

    hum.PlatformStand = true

    local cf    = cam.CFrame
    local spd   = S.fly_spd
    local md    = hum.MoveDirection  -- ini dari joystick native, sudah world space

    local dir = Vector3.zero

    -- ── joystick input ──────────────────────────────────────
    -- MoveDirection dari roblox sudah dalam world space flat (Y=0)
    -- tapi kita mau arahnya ikutin camera horizontal plane
    -- jadi ambil komponen X dan Z dari MoveDirection,
    -- project ke camera right dan look (Y=0)
    if md.Magnitude > 0.05 then
        -- camera forward & right, flatten Y
        local camLook  = Vector3.new(cf.LookVector.X,  0, cf.LookVector.Z)
        local camRight = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)

        -- magnitude joystick di masing-masing axis
        -- md sudah relative to camera di roblox mobile, tinggal pake
        local fwd  = -md.Z   -- Z negatif = maju
        local rgt  =  md.X   -- X positif = kanan

        if camLook.Magnitude  > 0 then dir += camLook.Unit  * fwd end
        if camRight.Magnitude > 0 then dir += camRight.Unit * rgt end
    end

    -- ── naik: jump button ───────────────────────────────────
    if jumping then
        dir += Vector3.new(0, 1, 0)
    end

    -- ── turun: kamera hadap bawah + joystick maju ───────────
    -- ini otomatis: saat cam.LookVector.Y negatif dan ada input maju,
    -- komponen Y dari look akan menarik ke bawah
    -- tapi kita flatten di atas, jadi kita perlu tambah Y dari look
    -- hanya kalau joystick ada input
    if md.Magnitude > 0.05 then
        -- ambil komponen vertikal dari camera look
        -- kamera hadap bawah → LookVector.Y negatif → turun
        -- kamera hadap atas  → LookVector.Y positif → naik tambahan
        local verticalPull = cf.LookVector.Y * (-md.Z)
        dir += Vector3.new(0, verticalPull, 0)
    end

    -- normalize dan apply speed
    flyBV.Velocity = dir.Magnitude > 0.01
        and dir.Unit * spd
         or Vector3.zero

    flyBG.CFrame = cf
end)

