local function makeTab(label, icon, order)
    local btn = Instance.new("TextButton", sidebar)
    btn.Name = label
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(36, 36, 42)
    btn.BorderSizePixel = 0
    btn.LayoutOrder = order
    btn.Text = ""
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local icoL = Instance.new("TextLabel", btn)
    icoL.Size = UDim2.new(0, 22, 1, 0)
    icoL.Position = UDim2.new(0, 8, 0, 0)
    icoL.BackgroundTransparency = 1
    icoL.Text = icon
    icoL.TextColor3 = Color3.fromRGB(140, 140, 155)
    icoL.Font = Enum.Font.GothamBold
    icoL.TextSize = 14

    local nameL = Instance.new("TextLabel", btn)
    nameL.Size = UDim2.new(1, -34, 1, 0)
    nameL.Position = UDim2.new(0, 32, 0, 0)
    nameL.BackgroundTransparency = 1
    nameL.Text = label
    nameL.TextColor3 = Color3.fromRGB(140, 140, 155)
    nameL.Font = Enum.Font.GothamBold
    nameL.TextSize = 11
    nameL.TextXAlignment = Enum.TextXAlignment.Left

    local ind = Instance.new("Frame", btn)
    ind.Size = UDim2.new(0, 3, 0.6, 0)
    ind.Position = UDim2.new(0, 0, 0.2, 0)
    ind.BackgroundColor3 = Color3.fromRGB(100, 210, 120)
    ind.BorderSizePixel = 0
    ind.BackgroundTransparency = 1
    Instance.new("UICorner", ind).CornerRadius = UDim.new(1, 0)

    local page = Instance.new("ScrollingFrame", panel)
    page.Name = label.."Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 95)
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false

    local pLayout = Instance.new("UIListLayout", page)
    pLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pLayout.Padding = UDim.new(0, 10)
    local pPad = Instance.new("UIPadding", page)
    pPad.PaddingTop = UDim.new(0, 14)
    pPad.PaddingLeft = UDim.new(0, 14)
    pPad.PaddingRight = UDim.new(0, 14)
    pPad.PaddingBottom = UDim.new(0, 14)

    tabs[label] = {btn=btn, page=page, ind=ind, icoL=icoL, nameL=nameL}

    local function activate()
        if active then
            local a = tabs[active]
            TweenService:Create(a.btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(36,36,42)
            }):Play()
            TweenService:Create(a.ind, TweenInfo.new(0.2), {BackgroundTransparency=1}):Play()
            a.nameL.TextColor3 = Color3.fromRGB(140,140,155)
            a.icoL.TextColor3  = Color3.fromRGB(140,140,155)
            a.page.Visible = false
        end
        active = label
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(40,42,40)
        }):Play()
        TweenService:Create(ind, TweenInfo.new(0.2), {BackgroundTransparency=0}):Play()
        nameL.TextColor3 = Color3.fromRGB(100, 210, 120)
        icoL.TextColor3  = Color3.fromRGB(100, 210, 120)
        page.Visible = true
    end

    btn.MouseButton1Click:Connect(activate)
    return page, activate
end

